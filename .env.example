ETH_RPC_URL=
BASE_RPC_URL=
# 1Click partner JWT (https://partners.near-intents.org). Required for confidential
# quotes and withdrawals; public quotes without it pay 25 bps more. CLI/server only:
# never expose it to the browser.
ONECLICK_JWT=
# NEAR account that owns the confidential balance (default for --account).
# The demo recording names it publicly: use a dedicated demo account, not your main one.
SHELTER_NEAR_ACCOUNT=
# Default payee for burner preview/new when --to is not given. Also public in the
# demo recording: use an address you are happy to show.
SHELTER_DEMO_PAYEE=
# Reown (WalletConnect) Cloud project id for `connect start` (https://cloud.reown.com).
WALLETCONNECT_PROJECT_ID=
# Extra identities Connect keeps away from every dapp, comma-separated (0x... and NAME.near);
# `connect link add` stores them in ~/.shelter/linked.json instead.
SHELTER_LINKED_ADDRESSES=
NEAR_AI_API_KEY=
# TEE-hosted model on NEAR's own fleet (provider=near); canonical id, not an alias.
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Web app only: set to 1 to select the live Connect wallet source instead of the
# recorded session. Requires the browser entry in packages/connect; until then
# the flag only shows a typed stub that explains live mode is not in this build.
NEXT_PUBLIC_SHELTER_LIVE=
